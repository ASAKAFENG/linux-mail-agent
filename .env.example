# Copy to .env and fill in real values.
# Never commit this file.

# --- IMAP (required) ---
MAIL_IMAP_HOST=imap.example.com
MAIL_IMAP_PORT=993
MAIL_IMAP_SSL=true
MAIL_IMAP_USER=you@example.com
MAIL_IMAP_PASSWORD=your-app-password

# --- SMTP (optional; defaults to IMAP host when omitted) ---
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=587
MAIL_SMTP_SSL=false
MAIL_SMTP_STARTTLS=true

# --- Identity ---
# MAIL_FROM=you@example.com
# MAIL_FROM_NAME="Your Name"

# --- Behaviour ---
# MAIL_TIMEOUT=30
# MAIL_ATTACHMENT_DIR=/home/you/.local/share/linux-mail-agent/attachments
# MAIL_READ_ONLY=true
# MAIL_ALLOWED_TO=you@example.com,other@example.com   # send allowlist; unset = any recipient
